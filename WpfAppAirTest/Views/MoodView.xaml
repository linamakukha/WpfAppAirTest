<UserControl x:Class="WpfAppAirTest.Views.MoodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:WpfAppAirTest.Models"
             xmlns:vm="clr-namespace:WpfAppAirTest.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MoodViewModel}"
             d:DesignWidth="480" d:DesignHeight="680">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type models:MoodEntry}">
            <Border Style="{StaticResource TaskCardStyle}">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="12" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding Mood.Brush}" />
                    <TextBlock Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center"
                               Text="{Binding Mood.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding TimeText}" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="24" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Margin="18,6,0,0" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                Command="{Binding DataContext.ShowPlannerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Planner" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="28,0,22,20" Margin="0,0,6,0">
            <StackPanel>
                <!-- Question -->
                <TextBlock Text="Mood check-in" Margin="0,10,0,0" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="How are you feeling today?" Margin="0,2,0,0" FontSize="28" FontWeight="Bold"
                           FontFamily="Segoe UI Variable Display, Segoe UI" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />

                <!-- Preset bubbles -->
                <ListBox Margin="-5,22,-5,0" Style="{StaticResource BubbleListStyle}"
                         ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedMood}" />

                <!-- Manual input -->
                <TextBlock Text="Or describe it in your own words" Margin="2,24,0,10" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Style="{StaticResource InputCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Margin="4,0,10,0" Style="{StaticResource PlannerTextBox}"
                                 Tag="e.g. a little nostalgic"
                                 Text="{Binding CustomMood, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveCommand}" ToolTip="Save mood (Enter)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Save" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Today's history -->
                <Grid Margin="2,28,0,12" Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TODAY'S CHECK-INS" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Grid.Column="1" Margin="12,0,0,0" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource CardBorderBrush}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

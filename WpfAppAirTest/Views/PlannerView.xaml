<UserControl x:Class="WpfAppAirTest.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:WpfAppAirTest.Models"
             xmlns:vm="clr-namespace:WpfAppAirTest.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignWidth="480" d:DesignHeight="680">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type models:TodoItem}">
            <Border x:Name="Card" Style="{StaticResource TaskCardStyle}">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Triggers>
                    <!-- Fade + slide in whenever a card appears (added, or moved between lists) -->
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="12" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource RoundCheckBox}" IsChecked="{Binding IsDone}"
                              VerticalAlignment="Center" />

                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"
                               Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" />

                    <Border x:Name="DoneBadge" Grid.Column="2" Style="{StaticResource DoneBadgeStyle}"
                            Visibility="Collapsed">
                        <TextBlock Text="DONE" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource DoneBadgeForegroundBrush}" />
                    </Border>

                    <Button x:Name="DeleteButton" Grid.Column="3" Margin="6,0,0,0" Opacity="0"
                            Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="Remove"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter TargetName="DoneBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-24" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: greeting, date, progress and mood check-in -->
        <StackPanel Grid.Row="0" Margin="28,14,28,0">
            <TextBlock Text="{Binding Greeting}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding TodayText}" Margin="0,2,0,0" FontSize="30" FontWeight="Bold"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />

            <Grid Margin="0,18,0,0">
                <TextBlock Text="{Binding ProgressText}" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding ProgressPercentText}" HorizontalAlignment="Right" FontSize="12.5"
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentSolidBrush}" />
            </Grid>
            <ProgressBar Style="{StaticResource SlimProgressBar}" Margin="0,8,0,0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}" />

            <!-- Entry point to the mood screen; bound to the shell rather than the planner -->
            <Button Margin="0,18,0,0" Style="{StaticResource CardButtonStyle}"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    d:DataContext="{d:DesignInstance vm:ShellViewModel}"
                    Command="{Binding ShowMoodCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mood.HasEntries}" Value="True">
                                        <Setter Property="Background" Value="{Binding Mood.LatestEntry.Mood.Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#xE76E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Mood.SummaryTitle}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Mood.SummarySubtitle}" Margin="0,1,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Button>
        </StackPanel>

        <!-- New task input -->
        <Border Grid.Row="1" Margin="28,18,28,16" Style="{StaticResource InputCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NewTaskBox" Margin="4,0,10,0" Style="{StaticResource PlannerTextBox}"
                         Tag="What do you want to get done?"
                         Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Command="{Binding AddCommand}"
                        ToolTip="Add task (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Add" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Task lists: pending on top, done at the bottom -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="28,0,22,20" Margin="0,0,6,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Pending}" ItemTemplate="{StaticResource TaskTemplate}" />

                <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="36"
                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentSolidBrush}" />
                    <TextBlock Text="Your day is wide open" Margin="0,14,0,4" HorizontalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Add your first task above to get started." HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Grid Margin="2,12,0,12" Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DONE" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Grid.Column="1" Margin="8,0,12,0" Style="{StaticResource DoneBadgeStyle}" Padding="7,1">
                        <TextBlock Text="{Binding DoneCount}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource DoneBadgeForegroundBrush}" />
                    </Border>
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource CardBorderBrush}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource TaskTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F5FF" Offset="0" />
        <GradientStop Color="#EDF0FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#DB2777" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentSolidBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#C4B5FD" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FBFAFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E7E3F7" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1B3A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#77739A" />

    <SolidColorBrush x:Key="CheckBoxRingBrush" Color="#C9C3E6" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E3DFF4" />
    <SolidColorBrush x:Key="DoneBadgeBackgroundBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="DoneBadgeForegroundBrush" Color="#15803D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000" />

    <DropShadowEffect x:Key="CardShadow" x:Shared="False" Color="#5B21B6"
                      BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.08" />

</ResourceDictionary>

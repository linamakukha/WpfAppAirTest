<mah:MetroWindow x:Class="WpfAppAirTest.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:WpfAppAirTest.ViewModels"
                 xmlns:views="clr-namespace:WpfAppAirTest.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ShellViewModel}"
                 Title="Day Planner" Height="720" Width="480" MinHeight="500" MinWidth="380"
                 WindowStartupLocation="CenterScreen"
                 TitleCharacterCasing="Normal" TitleBarHeight="40"
                 WindowTitleBrush="Transparent" NonActiveWindowTitleBrush="Transparent"
                 OverrideDefaultWindowCommandsBrush="{DynamicResource TextSecondaryBrush}"
                 BorderThickness="0"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 NonActiveGlowBrush="{DynamicResource CardBorderBrush}"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Title bar: app badge + title on the transparent MahApps title bar -->
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands ShowSeparators="False">
            <Button x:Name="ThemeButton" FontFamily="{StaticResource IconFont}" FontSize="13"
                    ToolTip="Switch light/dark theme" Click="ThemeButton_Click" />
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Resources>
        <!-- Each page view model is rendered by its view -->
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:PlannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MoodViewModel}">
            <views:MoodView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <!-- Current page: planner or mood check-in, cross-faded on change -->
    <mah:TransitioningContentControl Content="{Binding CurrentPage}" Transition="Default" Focusable="False" />
</mah:MetroWindow>
